{
  "manifest_version": 3,
  "name": "ShowKey",
  "version": "0.1.0",
  "description": "Play a browser tab in your show key and remember your rehearsal setlist.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShowKey"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}